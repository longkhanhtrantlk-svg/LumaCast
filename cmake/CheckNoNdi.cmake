# Dung khi thu muc dong goi (DIR) chua runtime/SDK cua NDI (SPEC muc 5.1: KHONG phan phoi kem).
#   cmake -DDIR=<thu muc> -P cmake/CheckNoNdi.cmake
if(NOT DEFINED DIR OR NOT IS_DIRECTORY "${DIR}")
  message(FATAL_ERROR "CheckNoNdi: thieu -DDIR hoac thu muc khong ton tai: '${DIR}'")
endif()
file(GLOB_RECURSE _all LIST_DIRECTORIES false "${DIR}/*")
set(_bad "")
foreach(_f ${_all})
  get_filename_component(_n "${_f}" NAME)
  string(TOLOWER "${_n}" _l)
  if(_l MATCHES "^processing\\.ndi" OR _l MATCHES "^libndi" OR _l MATCHES "^ndi.*\\.(dll|so|dylib)$")
    list(APPEND _bad "${_f}")
  endif()
endforeach()
if(_bad)
  string(REPLACE ";" "\n  " _msg "${_bad}")
  message(FATAL_ERROR "KHONG duoc dong goi runtime/SDK NDI (SPEC 5.1). Tim thay:\n  ${_msg}")
endif()
message(STATUS "CheckNoNdi: khong co file NDI trong ${DIR}")
