# Kiem thu bo cai (ctest "installer"). KHONG build bo cai: kiem tra kich ban NSIS va trang thong bao duoc sinh ra.
#   cmake -DBUILD_DIR=<build> -DSOURCE_DIR=<repo> -P cmake/TestInstaller.cmake
cmake_minimum_required(VERSION 3.21)

set(_out "${BUILD_DIR}/_installertest")
file(REMOVE_RECURSE "${_out}")
include("${SOURCE_DIR}/cmake/Notices.cmake")
foreach(_l vi en)
  set(_src "${SOURCE_DIR}/THIRD-PARTY-NOTICES.txt")
  if(_l STREQUAL "en")
    set(_src "${SOURCE_DIR}/THIRD-PARTY-NOTICES.en.txt")
  endif()
  lc_installer_notices("${_src}" "${_out}/notices-${_l}.txt")
  file(READ "${_out}/notices-${_l}.txt" _hex HEX)
  string(SUBSTRING "${_hex}" 0 6 _bom)
  string(FIND "${_hex}" "0d0a" _crlf)
  string(FIND "${_hex}" "0d0d0a" _double)
  if(NOT _bom STREQUAL "efbbbf" OR _crlf LESS 0 OR NOT _double LESS 0)
    message(FATAL_ERROR "notices-${_l}.txt phai co BOM UTF-8 va xuong dong CRLF")
  endif()
endforeach()
file(REMOVE_RECURSE "${_out}")

file(READ "${SOURCE_DIR}/packaging/installer.nsi" _hex LIMIT 3 HEX)
if(NOT _hex STREQUAL "efbbbf")
  message(FATAL_ERROR "installer.nsi phai mo dau bang BOM UTF-8 (chu co dau)")
endif()
file(READ "${SOURCE_DIR}/packaging/installer.nsi" _t)
function(_need text what)
  string(FIND "${_t}" "${text}" _at)
  if(_at LESS 0)
    message(FATAL_ERROR "installer.nsi thieu ${what}: ${text}")
  endif()
endfunction()
string(REGEX MATCHALL "!insertmacro MUI_LANGUAGE \"[A-Za-z]+\"" _langs "${_t}")
if(NOT _langs STREQUAL "!insertmacro MUI_LANGUAGE \"Vietnamese\";!insertmacro MUI_LANGUAGE \"English\"")
  message(FATAL_ERROR "Bo cai phai chi co Vietnamese (dau tien) va English: ${_langs}")
endif()
_need("Unicode true" "che do Unicode")
_need("RequestExecutionLevel user" "cai khong can admin")
_need("StrCpy \$LANGUAGE \${LANG_VIETNAMESE}" "mac dinh Tieng Viet")
_need("!insertmacro MUI_LANGDLL_DISPLAY" "hop thoai chon ngon ngu")
_need("MUI_PAGE_LICENSE \"\$(lcNotices)\"" "trang thong bao theo ngon ngu")
_need("IMAGENAME eq lumacast.exe" "khong cai de khi LumaCast dang chay")
_need("--silent" "chay Setup.exe cua Velopack im lang")
# khoa cai dat app doc o lan mo dau (lc::i18n::kKeyInstallLanguage = "ui/installLanguage")
_need("WriteRegStr HKCU \"Software\\LumaCast\\LumaCast\\ui\" \"installLanguage\"" "ghi ngon ngu cho lan mo app dau")
file(READ "${SOURCE_DIR}/src/core/I18n.h" _h)
string(FIND "${_h}" "kKeyInstallLanguage = \"ui/installLanguage\"" _at)
if(_at LESS 0)
  message(FATAL_ERROR "Khoa trong I18n.h khong con khop voi installer.nsi")
endif()
# icon: bo cai NSIS va bo cai Velopack (Setup.exe) dung cung file voi lumacast.exe
_need("!define MUI_ICON \"\${__FILEDIR__}\\..\\resources\\icon\\lumacast.ico\"" "icon cua bo cai")
file(READ "${SOURCE_DIR}/cmake/Package.cmake" _p)
string(FIND "${_p}" "--icon \"\${SOURCE_DIR}/resources/icon/lumacast.ico\"" _at)
if(_at LESS 0 OR NOT EXISTS "${SOURCE_DIR}/resources/icon/lumacast.ico")
  message(FATAL_ERROR "Package.cmake phai truyen --icon cho vpk, va resources/icon/lumacast.ico phai ton tai")
endif()
string(FIND "${_p}" "--framework" _at)
if(NOT _at LESS 0)
  message(FATAL_ERROR "Package.cmake khong duoc dung --framework (bo cai se doi tai tu mang); VC++ runtime da di kem goi")
endif()
# ten loi tat/quay ve va ma app: bo cai cu (CPack) phai duoc nhan ra
_need("CurrentVersion\\Uninstall\\LumaCast" "phat hien ban cai kieu cu")
message(STATUS "installer: OK (hai ngon ngu, hoi ngay dau, thong bao UTF-8 theo ngon ngu, chay Velopack im lang)")
